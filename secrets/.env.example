# Yassir Job Profile — Secrets
# Copy this to secrets/yassir.env and fill in real values

# Jira
YASSIR_JIRA_DOMAIN=https://your-org.atlassian.net
YASSIR_JIRA_EMAIL=your-email@company.com
YASSIR_JIRA_TOKEN=your-jira-api-token

# GitHub
YASSIR_GITHUB_ORG=your-github-org
YASSIR_GITHUB_TOKEN=ghp_your-github-token

# Slack
YASSIR_SLACK_WORKSPACE=your-workspace
YASSIR_SLACK_BOT_TOKEN=xoxb-your-slack-bot-token

# GCP
YASSIR_GCP_PROJECT=your-gcp-project-id

# Agent-to-agent auth (shared across all agents)
AGENT_API_KEY=generate-a-strong-random-key-here
